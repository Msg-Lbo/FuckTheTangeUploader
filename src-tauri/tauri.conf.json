{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "固件版本推送工具",
  "version": "0.1.0",
  "identifier": "com.genata.firmware-pusher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "固件版本推送工具",
        "width": 1080,
        "height": 760,
        "resizable": true,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZDOUU4QzJGMkQzREU3QTkKUldTcDV6MHRMNHllYk5QQmsydHdmbFE0MnVyTzJWQ3dEa0pxbnQ1VGplYVl6YlErVGlTcUV1a24K",
      "endpoints": [
        "https://raw.githubusercontent.com/Msg-Lbo/FuckTheTangeUploader/main/updater/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "publisher": "Genata",
    "shortDescription": "固件 OTA 推送工具",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
